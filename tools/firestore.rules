rules_version = '2';
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여넣고 [게시]
service cloud.firestore {
  match /databases/{db}/documents {
    // 회원 정보: 읽기는 누구나, 쓰기는 본인만 (닉네임 2~12자)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.nickname is string
                   && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 12;
    }
    // 닉네임 중복 방지: 문서 이름 = 닉네임(소문자). 처음 만들 때만, 본인 것만 / 지울 때도 본인 것만
    match /nicknames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
